{
  "name": "phrasic",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@latest",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "clean": "bun run scripts/clean.ts",
    "build": "bun run scripts/build.ts",
    "build:local-host": "bun run scripts/build-local-host.ts",
    "codegen": "bun run scripts/codegen.ts",
    "codegen:check": "bun run codegen && git diff --exit-code -- apps/web/src/browser/generated fixtures/local-media/v1",
    "serve": "bun scripts/serve.ts",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --project tsconfig.json",
    "typecheck:browser": "tsc --project tsconfig.browser.json",
    "test:local-media-browser": "bun run scripts/verify-local-media-browser.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "google-protobuf": "^4.0.2",
    "grpc-web": "^2.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/google-protobuf": "^3.15.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "bun-plugin-tailwind": "^0.1.2",
    "husky": "^9.1.7",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
